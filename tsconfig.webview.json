{
  // The webviews' scripts (media/*.js, each `// @ts-check`) and the web access page (src/web/page/), in the browser,
  // strict but for implicit any.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vscode"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false
  },
  "include": ["media/*.js", "media/*.d.ts", "src/web/page/**/*.ts"]
}
